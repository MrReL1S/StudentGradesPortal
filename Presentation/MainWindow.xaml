<Window x:Class="StudentGradesPortal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:StudentGradesPortal.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:StudentGradesPortal.Models;assembly=StudentGradesPortal.Models"
        xmlns:views="clr-namespace:StudentGradesPortal.Views"
        Title="StudentGradesPortal"
        Width="1260"
        Height="760"
        MinWidth="1120"
        MinHeight="640"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToFinalTextConverter x:Key="FinalTextConverter" />
        <converters:GradeToBrushConverter x:Key="GradeBrushConverter" />
        <converters:PassingToTextConverter x:Key="PassingTextConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="116" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="30,22"
                Background="{StaticResource HeaderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource HeaderTitleStyle}"
                               Text="StudentGradesPortal" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource HeaderSubtitleStyle}"
                               Text="Портал оценок студентов и учебной успеваемости" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <TextBox Width="260"
                             Margin="0,0,12,0"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по студенту, группе, дисциплине, типу работы, комментарию и текстовой оценке" />
                    <Button Width="154"
                            Command="{Binding ClearFailedCommand}"
                            Content="Убрать пересдачи"
                            Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,18"
                         Columns="6">
                <Border Margin="0,0,12,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding TotalCount}" />
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="записей" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding AverageGrade, StringFormat={}{0:F2}}" />
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="средний балл" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding ExcellentCount}" />
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="отличных" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding FailedCount}" />
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="пересдач" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding PassingCount}" />
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="успешных" />
                    </StackPanel>
                </Border>
                <Border Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding FinalCount}" />
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="итоговых" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,18,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Журнал оценок" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding CurrentFilterTitle, StringFormat=Текущий фильтр: {0}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static models:GradeStatusFilter.All}"
                            Content="Все"
                            Style="{StaticResource FilterButtonStyle}" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static models:GradeStatusFilter.Excellent}"
                            Content="Отличники"
                            Style="{StaticResource FilterButtonStyle}" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static models:GradeStatusFilter.Passing}"
                            Content="Без долгов"
                            Style="{StaticResource FilterButtonStyle}" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static models:GradeStatusFilter.Failed}"
                            Content="Пересдача"
                            Style="{StaticResource FilterButtonStyle}" />
                    <Button Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static models:GradeStatusFilter.Final}"
                            Content="Итоговые"
                            Style="{StaticResource FilterButtonStyle}" />
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="2"
                      Grid.Column="0"
                      Margin="0,0,16,0"
                      ItemsSource="{Binding RecordsView}"
                      SelectedItem="{Binding SelectedRecord}"
                      Style="{StaticResource JournalDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Оценка" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="36"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding GradeValue, Converter={StaticResource GradeBrushConverter}}"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="{Binding GradeValue}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding StudentName}"
                                        Header="Студент"
                                        IsReadOnly="True"
                                        Width="130" />
                    <DataGridTextColumn Binding="{Binding GroupName}"
                                        Header="Группа"
                                        IsReadOnly="True"
                                        Width="70" />
                    <DataGridTextColumn Binding="{Binding Subject}"
                                        Header="Дисциплина"
                                        IsReadOnly="True"
                                        Width="150" />
                    <DataGridTextColumn Binding="{Binding WorkType}"
                                        Header="Работа"
                                        IsReadOnly="True"
                                        Width="145" />
                    <DataGridTextColumn Binding="{Binding AssessmentDate, StringFormat=dd.MM.yyyy}"
                                        Header="Дата"
                                        IsReadOnly="True"
                                        Width="86" />
                    <DataGridTemplateColumn Header="Статус" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding IsPassing, Converter={StaticResource PassingTextConverter}}" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding IsFinal, Converter={StaticResource FinalTextConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="72"
                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="Удалить"
                                        Style="{StaticResource DangerButtonStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    Padding="18"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8">
                <views:GradeEditorView />
            </Border>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Margin="0,12,18,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
</Window>
