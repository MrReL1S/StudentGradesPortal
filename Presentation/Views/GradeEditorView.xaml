<UserControl x:Class="StudentGradesPortal.Views.GradeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="320"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock Style="{StaticResource SectionTitleStyle}"
                       Text="Карточка оценки" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="Добавление и изменение записи журнала" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Студент" />
                <TextBox Margin="0,6,0,14"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding Editor.StudentName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Группа" />
                <ComboBox Margin="0,6,0,14"
                          IsEditable="True"
                          ItemsSource="{Binding GroupOptions}"
                          SelectedItem="{Binding Editor.GroupName}"
                          Style="{StaticResource InputComboBoxStyle}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Дисциплина" />
                <ComboBox Margin="0,6,0,14"
                          IsEditable="True"
                          ItemsSource="{Binding SubjectOptions}"
                          SelectedItem="{Binding Editor.Subject}"
                          Style="{StaticResource InputComboBoxStyle}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Тип работы" />
                <ComboBox Margin="0,6,0,14"
                          IsEditable="True"
                          ItemsSource="{Binding WorkTypeOptions}"
                          SelectedItem="{Binding Editor.WorkType}"
                          Style="{StaticResource InputComboBoxStyle}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Оценка" />
                <ComboBox Margin="0,6,0,14"
                          ItemsSource="{Binding GradeOptions}"
                          SelectedItem="{Binding Editor.GradeValue}"
                          Style="{StaticResource InputComboBoxStyle}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Дата" />
                <DatePicker Margin="0,6,0,14"
                            SelectedDate="{Binding Editor.AssessmentDate}"
                            Style="{StaticResource InputDatePickerStyle}" />

                <CheckBox Margin="0,0,0,14"
                          Content="Итоговая оценка"
                          IsChecked="{Binding Editor.IsFinal}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Комментарий" />
                <TextBox Height="86"
                         Margin="0,6,0,16"
                         AcceptsReturn="True"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding Editor.Comment, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Button Command="{Binding AddRecordCommand}"
                    Content="Добавить запись"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Margin="0,10,0,0"
                    Command="{Binding SaveSelectedRecordCommand}"
                    Content="Сохранить выбранную"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Margin="0,10,0,0"
                    Command="{Binding DeleteRecordCommand}"
                    Content="Удалить выбранную"
                    Style="{StaticResource DangerButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
